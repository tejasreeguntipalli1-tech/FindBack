# FindBack — Apache Production Configuration
# Options & Encoding
Options -Indexes
AddDefaultCharset UTF-8

# Prevent access to hidden files and system directories
<FilesMatch "^\.(env|git|gitignore|htaccess)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect database dump files from direct web download
<FilesMatch "(database\.sql|campusfind\.sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent access to test scripts in production
<FilesMatch "^(test_.*\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable Gzip Compression for text assets if mod_deflate is available
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>

# Browser Caching Headers for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
